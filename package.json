{
  "name": "accounting-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "db:push": "drizzle-kit push",
    "db:init": "tsx server/init-db.ts",
    "db:seed": "tsx server/seed.ts",
    "build:client": "vite build",
    "build": "npm run build:client",
    "start": "NODE_ENV=production tsx server/index.ts",
    "cf:dev": "wrangler dev",
    "cf:migrate": "wrangler d1 execute accounting-system-db --remote --file=migrations/0000_init.sql",
    "cf:migrate:local": "wrangler d1 execute accounting-system-db --local --file=migrations/0000_init.sql",
    "cf:deploy": "wrangler deploy",
    "cf:pages:deploy": "npm run build:client && wrangler pages deploy dist/client --project-name=accounting-system"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "drizzle-kit": "^0.24.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wrangler": "^3.90.0"
  }
}
